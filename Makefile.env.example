# Copy to Makefile.env and edit. Sourced by every script in scripts/.
# Makefile.env is gitignored.

# SSH private key matching the EC2 key pair (vish-keypair by default).
SSH_KEY=~/.ssh/vish-keypair.pem

# Path to the go-ycsb fork built in Phase A. Relative paths are resolved
# from the repo root.
YCSB_DIR=../go-ycsb-ccaas
